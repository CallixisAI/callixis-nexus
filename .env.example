# Copy this file to `.env` and fill in the values, then restart `npm run dev`.
#
#   cp .env.example .env
#
# `.env` is gitignored. `.env.example` is committed and must never hold a real key.
#
# Vite only exposes variables prefixed with VITE_ to browser code, and everything
# it exposes is PUBLIC — it ends up in the JavaScript bundle any visitor can read.
# So only the anon/publishable key belongs here. The service-role key must never
# appear in this file; it lives in Supabase edge function secrets (see bottom).

# ── Required: the app will not start without these ───────────────────────────

# Project ref is `orjuyfisawhteflpduso` per supabase/config.toml.
# VITE_SUPABASE_URL=https://orjuyfisawhteflpduso.supabase.co

# Supabase Dashboard → Project Settings → API Keys → anon / publishable.
# Safe to ship to the browser: it grants nothing on its own, because every table
# is protected by row-level security policies (see supabase/migrations/).
# VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Server-side secrets — NOT set here ───────────────────────────────────────
#
# These are read by the Deno edge functions in supabase/functions/ via
# Deno.env.get(...), and are configured on Supabase, never in this file:
#
#   SUPABASE_SERVICE_ROLE_KEY   auto-injected by Supabase; bypasses RLS entirely
#   ELEVENLABS_API_KEY          used by functions/elevenlabs-tts
#   LOVABLE_API_KEY             used by functions/plugin-setup-chat
#
# Set them with:
#   npx supabase secrets set ELEVENLABS_API_KEY=...
#
# The n8n webhook URL is deliberately NOT an environment variable — it is stored
# per-user in the `user_plugins` table (plugin_id = 'n8n', config.webhookUrl) and
# is set through the app's Plugins page.


VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
